{
  "name": "OG Fieldwork",
  "short_name": "OG Fieldwork",
  "description": "Opifex Geotechnics field data capture - borehole logs, DCP/PSP tests and site photos, with log sheets printed on site.",
  "id": "og-fieldwork",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#eef0e8",
